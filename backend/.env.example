# SSLGuard Configuration
PROJECT_NAME="SSLGuard — SSL Certificate Monitoring & WhatsApp Alert System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT (Ganti SECRET_KEY untuk produksi)
SECRET_KEY="sslguard-kominfo-pkl2026-super-secret-key-production-ready"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite lokal tanpa instalasi server, atau PostgreSQL)
DATABASE_URL="sqlite:///./sslguard.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sslguard"

# SSL Engine
SSL_DEFAULT_PORT=443
SSL_SOCKET_TIMEOUT_SECONDS=5
SSRF_PROTECTION_ENABLED=true

# Scheduler (07:00 WIB)
SCHEDULER_ENABLED=true
SCHEDULER_CRON_HOUR=7
SCHEDULER_CRON_MINUTE=0
TIMEZONE="Asia/Jakarta"

# WhatsApp Cloud API (Meta)
WHATSAPP_SIMULATION_MODE=true
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ADMIN_PHONE="+6281198765432"
